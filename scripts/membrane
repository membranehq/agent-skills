#!/bin/sh
# The `membrane` command of the Membrane plugin, version 0.1.14835.
#
# The plugin's code is one program, `membrane.mjs` beside this script. If this computer has Node
# 22.13 or newer, this script runs the program with that Node. Otherwise it runs the program compiled
# for this computer, which carries its own runtime: it downloads that executable from the
# repository's GitHub release, checks it against the SHA-256 written below, and keeps it under that
# checksum. A plugin update that leaves the program alone therefore downloads nothing.
#
# Generated by client-plugin/scripts/build-release.ts from client-plugin/src/launcher.sh.

program='membrane'
version='0.1.14835'
release_url='https://github.com/membranehq/agent-skills/releases/download/v0.1.14835'
# One line per platform: the platform, the SHA-256 of the gzipped executable, and its size in bytes.
executables='
darwin-arm64 7effb7a3dcf95deeb5dbb417a21fa4d0675a42bea6ab560c0d08be28a2ed0c56 30512456
darwin-x64 e1935da10a42aef49f49b6d356d70357b2195e588e1ac60fd1762150338ecd7e 33201175
linux-arm64 9889f4ea7cfa4384408b8ce3ce9b5ed4bf801a0dd3a97d3d1909ec33168bf37e 41672893
linux-x64 66a61fd7e791b63bdd018588a5bf9755e7d44373ed5d7bab8d294bcef2cb8d5b 41954419
'

# The session-start hook runs before the person's first message, and the host stops it after 10
# seconds. The whole hook command keeps one deadline this many seconds after it starts. A first
# download stops 2 seconds before the deadline, and the program waits for Membrane only for the time
# that is left, so the hook always prints in time. A download it cannot finish is left to the next
# command.
hook_seconds=8

hook=
if [ "$program" = membrane ] && [ "${1-}" = hook ]; then
  hook=1
  hook_deadline=$(( $(date +%s) + hook_seconds ))
  # The program reads the deadline in milliseconds since the epoch.
  MEMBRANE_HOOK_DEADLINE_MS=$(( hook_deadline * 1000 ))
  export MEMBRANE_HOOK_DEADLINE_MS
fi

# The program carries no version of its own, so that a release that changes no code builds the same
# program. It reads the version from here.
MEMBRANE_PLUGIN_VERSION=$version
export MEMBRANE_PLUGIN_VERSION

# The program writes `membrane` into files another program runs later: the cached guides, and the
# credential helper of a workspace clone. It names a script under its home that runs this file, and
# reads this file's absolute path here to write that script.
case "$0" in
  /*) MEMBRANE_LAUNCHER_PATH=$0 ;;
  */*) MEMBRANE_LAUNCHER_PATH="$(cd "${0%/*}" 2>/dev/null && pwd)/${0##*/}" ;;
  *) MEMBRANE_LAUNCHER_PATH= ;;
esac
export MEMBRANE_LAUNCHER_PATH

json_text() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Ends the run the way every verb ends a failure: the error as JSON on stdout, the message as one
# status line on stderr, exit 1. The hook instead tells the agent why the plugin is not ready and
# exits 0, because a failing hook costs the person their session start.
fail() {
  if [ -n "$hook" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
      "$(json_text "The Membrane plugin is installed but not ready. $2")"
    exit 0
  fi
  printf '{\n  "error": "%s",\n  "message": "%s"\n}\n' "$1" "$(json_text "$2")"
  printf '%s\n' "$2" >&2
  exit 1
}

# The program runs on Node 22.13 or newer, and 23.4 or newer on the 23 line: the first releases that
# load `node:sqlite` without a flag, so a tool can keep its data in it. MEMBRANE_NO_NODE=1 runs the
# downloaded program even when this computer has such a Node.
node_is_usable() {
  [ -z "${MEMBRANE_NO_NODE-}" ] || return 1
  node_version=$(node --version 2>/dev/null) || return 1
  node_version=${node_version#v}
  node_major=${node_version%%.*}
  node_minor=${node_version#*.}
  node_minor=${node_minor%%.*}
  case "$node_major" in '' | *[!0-9]*) return 1 ;; esac
  case "$node_minor" in '' | *[!0-9]*) return 1 ;; esac
  [ "$node_major" -ge 24 ] ||
    { [ "$node_major" -eq 23 ] && [ "$node_minor" -ge 4 ]; } ||
    { [ "$node_major" -eq 22 ] && [ "$node_minor" -ge 13 ]; }
}

case "$0" in
  */*) scripts_dir=${0%/*} ;;
  *) scripts_dir=. ;;
esac
bundle="$scripts_dir/membrane.mjs"
if [ -f "$bundle" ] && node_is_usable; then
  # Node warns on stderr when a program loads an experimental module such as `node:sqlite`, and every
  # verb promises one status line there. The program passes the flag on to the copies of itself it
  # starts.
  exec node --disable-warning=ExperimentalWarning "$bundle" "$program" "$@"
fi

detect_target() {
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) fail unsupported-platform "The Membrane plugin runs on macOS and Linux, and this computer runs $(uname -s). With Node 22.13 or newer it runs anywhere." ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) cpu=x64 ;;
    arm64 | aarch64) cpu=arm64 ;;
    *) fail unsupported-platform "The Membrane plugin runs on x64 and arm64 processors, and this computer has $(uname -m). With Node 22.13 or newer it runs on any processor." ;;
  esac
  # A shell that Rosetta translates reports x64 on an Apple silicon Mac, which runs arm64 natively.
  if [ "$os" = darwin ] && [ "$cpu" = x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then
    cpu=arm64
  fi
  target="$os-$cpu"
}

download() {
  if [ "$os" = linux ]; then
    case "$(ldd --version 2>&1)" in
      *musl*) fail unsupported-platform "The Membrane plugin's own program needs a Linux with glibc, and this one uses musl. With Node 22.13 or newer the plugin runs here." ;;
    esac
  fi
  megabytes=$(( (bytes + 524288) / 1048576 ))
  # MEMBRANE_DOWNLOAD_URL names another place that holds the same files. The checksum still decides.
  url="${MEMBRANE_DOWNLOAD_URL:-$release_url}/membrane-$target.gz"

  mkdir -p "$dir" || fail download-failed "The plugin could not create $dir for its program."
  partial="$dir/.membrane-$target.$$"
  trap 'rm -f "$partial" "$partial.gz"' EXIT
  if [ -n "$hook" ]; then
    trap 'fail download-failed "The download of $url stopped before it finished. Every plugin command tries again."' HUP INT TERM
  else
    trap 'exit 1' HUP INT TERM
  fi

  printf 'Downloading the Membrane program for %s (%s MB). It downloads again only when a plugin update changes it.\n' \
    "$target" "$megabytes" >&2
  if command -v curl >/dev/null 2>&1; then
    if [ -n "$hook" ]; then
      hook_wait=$(( hook_deadline - $(date +%s) - 2 ))
      if [ "$hook_wait" -lt 1 ]; then hook_wait=1; fi
      curl -fsSL --max-time "$hook_wait" -o "$partial.gz" "$url"
    else
      curl -fsSL --connect-timeout 20 --retry 2 -o "$partial.gz" "$url"
    fi
  elif ! command -v wget >/dev/null 2>&1; then
    fail no-downloader "The Membrane plugin downloads its program with curl or wget, and this computer has neither."
  elif [ -n "$hook" ]; then
    # wget bounds each network operation, not the whole download, so it cannot keep the hook's
    # deadline. The first plugin command downloads with it instead.
    fail download-deferred "It downloads its program during session start only with curl, and this computer has wget. The first plugin command downloads it."
  else
    wget -q -T 20 -O "$partial.gz" "$url"
  fi || fail download-failed "The download of $url failed. Every plugin command tries again."

  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$partial.gz")
  elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$partial.gz")
  else
    fail no-checksum "The Membrane plugin checks its download with sha256sum or shasum, and this computer has neither."
  fi
  if [ "${actual%% *}" != "$sha256" ]; then
    fail checksum-mismatch "The download of $url does not match the checksum of plugin version $version, so the plugin deleted it without running it."
  fi

  gzip -dc "$partial.gz" >"$partial" || fail download-failed "The download of $url did not unpack."
  if ! { chmod 755 "$partial" && mv -f "$partial" "$executable"; }; then
    fail download-failed "The plugin could not install its program at $executable."
  fi
  rm -f "$partial.gz"
  trap - EXIT HUP INT TERM

  # A download removes the programs nothing wrote for a week, so a session that still runs an older
  # plugin keeps its program meanwhile.
  find "$home/bin" -mindepth 1 -maxdepth 1 -type d ! -name "$sha256" -mtime +7 -exec rm -rf {} + 2>/dev/null
}

home=${MEMBRANE_HOME-}
if [ -z "$home" ]; then
  if [ -z "${HOME-}" ]; then
    fail no-home "Neither MEMBRANE_HOME nor HOME is set, so the plugin has nowhere to keep its program."
  fi
  home="$HOME/.membrane"
fi
detect_target
newline='
'
case "$executables" in
  *"$newline$target "*) ;;
  *) fail unsupported-platform "Version $version of the Membrane plugin has no program for $target." ;;
esac
line=${executables#*"$newline$target "}
line=${line%%"$newline"*}
sha256=${line%% *}
bytes=${line#* }
dir="$home/bin/$sha256"
executable="$dir/membrane-$target"
if [ ! -x "$executable" ]; then download; fi
exec "$executable" "$program" "$@"
